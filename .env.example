# ── Proveedor (Shoppex Partner API) ─────────────────────────────
# Docs: https://partners-api.shoppexcorp.com/docs
SHOPPEX_BASE_URL=https://partners-api.shoppexcorp.com
SHOPPEX_KEY=
SHOPPEX_SECRET=

# ── Servidor ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# URL pública de la tienda (sin barra final). Se usa en correos y OAuth.
SITE_URL=https://tu-tienda.up.railway.app
# ── Seguridad del panel ─────────────────────────────────────────
# Dirección del panel: una ruta que solo tú conozcas (no "admin"). Ej.: oficina-nvos-7k2
ADMIN_PATH=
# Contraseña: frase larga y única (14+ caracteres)…
ADMIN_PASSWORD=
# …o mejor, cifrada:  npm run hash-password -- "tu frase"  y pega aquí el resultado (deja ADMIN_PASSWORD vacío)
ADMIN_PASSWORD_HASH=
# A dónde llegan los avisos: acceso desde una IP nueva, intentos fallidos, pedidos retenidos, disputas
ADMIN_ALERT_EMAIL=
# Opcionales: IP desde las que se puede abrir el panel (separadas por coma)
ADMIN_IP_ALLOW=
# Proxies delante del servidor: 1 en Railway/Render; 2 si además usas Cloudflare
TRUST_PROXY=1
# Solo emergencia (teléfono perdido): ADMIN_2FA_RESET=1 apaga la verificación en 2 pasos; quítalo después
# Firma de cookies; pon una cadena larga y aleatoria
SESSION_SECRET=

# ── Supabase (Project Settings → API) ───────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=productos

# ── Correos (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=NVOS Shoppers <pedidos@tudominio.com>

# Dirección a la que responden los clientes (tu buzón de Google Workspace)
EMAIL_REPLY_TO=

# ── Envíos (ShipStation → Settings → Account → API Settings) ─────
SHIPSTATION_KEY=
SHIPSTATION_SECRET=

# ── Pagos con tarjeta: Square (developer.squareup.com → tu aplicación) ──
# Empieza en modo de prueba: SQUARE_ENV=sandbox con las llaves "Sandbox".
# Para cobrar de verdad: borra SQUARE_ENV y pon las llaves "Production".
SQUARE_ENV=sandbox
SQUARE_APP_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Webhooks → Signature key de la suscripción a  <SITE_URL>/api/square/webhook
# (eventos: payment.updated, refund.created, refund.updated, dispute.created)
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ── Secreto de los avisos entrantes ─────────────────────────────
# Lo usan el aviso de ShipStation (/api/shipstation/webhook?secret=…) y los
# avisos de ventas de Walmart / Mercado Libre (/api/channels/<canal>/order).
# Pon una cadena larga y aleatoria.
CHANNEL_WEBHOOK_SECRET=

# ── eBay (developer.ebay.com → Application Keys → Production) ───
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName del keyset; su "Auth accepted URL" debe ser  <SITE_URL>/api/admin/ebay/callback
EBAY_RUNAME=
# Cadena de 32 a 80 caracteres (letras, números, _ y -) para la verificación
# "Marketplace account deletion"; endpoint: <SITE_URL>/api/ebay/account-deletion
EBAY_VERIFICATION_TOKEN=
# Código postal desde donde despachas (solo si aún no tienes un almacén creado en eBay)
EBAY_SHIP_FROM_ZIP=
# Opcionales: EBAY_ENV=sandbox para probar · EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_FULFILLMENT_POLICY_ID / EBAY_PAYMENT_POLICY_ID / EBAY_RETURN_POLICY_ID / EBAY_LOCATION_KEY
# EBAY_CATEGORY_WOMEN / EBAY_CATEGORY_MEN / EBAY_CATEGORY_UNISEX

# ── Escáner: búsqueda por código de barras y fotos (opcionales) ─
# Sin llave: 100 consultas al día en UPCitemdb. Con plan de pago, pon su llave.
UPCITEMDB_KEY=
# Búsqueda de fotos con fondo blanco en Google (Programmable Search JSON API)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ── Otros marketplaces (aún en simulación) ──────────────────────
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=
MELI_TOKEN=
